---
import Icon from './Icon.astro';
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-brand-100">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <Icon name="chevron" class="size-4 rtl:rotate-180" />}
        {i < items.length - 1 ? <a href={it.path} class="hover:text-white">{it.name}</a> : <span aria-current="page" class="text-white">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
