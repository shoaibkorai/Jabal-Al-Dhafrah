---
import { contactFor, type Lang } from '../config/site';
import type { CountryCode } from '../data/cities';
import { t, waLink } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang; country?: CountryCode }
const { lang, country } = Astro.props;
const u = t(lang);
const ct = contactFor(country);
---
<!-- Always-visible call/WhatsApp bar on phones (thumb reach) -->
<div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 gap-2 border-t border-slate-200 bg-white/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden">
  <a href={`tel:${ct.phone}`} class="btn-primary"><Icon name="phone" class="size-5" />{u.call}</a>
  <a href={waLink(lang, undefined, ct.whatsapp)} class="btn-wa" target="_blank" rel="noopener"><Icon name="whatsapp" class="size-5" />{u.whatsapp}</a>
</div>
