---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BookingForm from '../components/BookingForm.astro';
import Faq from '../components/Faq.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, type Lang } from '../config/site';
import { t, href, waLink } from '../i18n/ui';
import { services, type Service } from '../data/services';
import { countries, countryOrder, topLevel } from '../data/cities';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import { servicePhoto } from '../lib/images';
interface Props { lang: Lang; service: Service }
const { lang, service: s } = Astro.props;
const u = t(lang);
const path = `/services/${s.slug}/`;
const crumbs = [
  { name: u.breadcrumbHome, path: href(lang, '/') },
  { name: u.nav.services, path: href(lang, '/services/') },
  { name: s.name[lang], path: href(lang, path) },
];
const faqs = s.faqs.map((f) => ({ q: f.q[lang], a: f.a[lang] }));
const others = services.filter((x) => x.slug !== s.slug);
const photo = servicePhoto(s.slug);
---
<Base lang={lang} path={path} title={s.title[lang]} description={s.short[lang]} ogImage={photo?.src}
  schema={[serviceSchema(s, lang), faqSchema(faqs), breadcrumbSchema(crumbs)]}>
  <section class="bg-gradient-to-br from-brand-900 to-brand-700 text-white">
    <div class="container-x grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-[1fr_440px]">
     <div>
      <Breadcrumbs items={crumbs} />
      <div class="mt-6 flex items-start gap-4">
        <span class="hidden size-14 shrink-0 items-center justify-center rounded-2xl bg-white/10 sm:flex"><Icon name={s.icon} class="size-8" /></span>
        <div>
          <h1 class="text-3xl leading-tight font-bold sm:text-4xl">{s.title[lang]}</h1>
          <p class="mt-4 max-w-2xl text-lg text-brand-100">{s.short[lang]}</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${site.phone}`} class="btn-primary text-lg"><Icon name="phone" class="size-5" />{u.callNow}</a>
        <a href={waLink(lang, `${u.form.waIntro}\n${u.form.service}: ${s.name[lang]}`)} target="_blank" rel="noopener" class="btn-wa text-lg"><Icon name="whatsapp" class="size-5" />{u.bookWhatsapp}</a>
      </div>
     </div>
      {photo && (
        <Image src={photo} alt={s.name[lang]} widths={[480, 800, 1000]} sizes="(min-width: 1024px) 440px, 100vw"
          loading="eager" fetchpriority="high" class="aspect-[16/10] w-full rounded-3xl object-cover shadow-2xl ring-1 ring-white/20" />
      )}
    </div>
  </section>

  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_380px]">
    <article>
      <div class="space-y-4 text-lg leading-relaxed">
        {s.intro[lang].map((p) => <p>{p}</p>)}
      </div>

      <h2 class="h2 mt-12">{u.problemsTitle}</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {s.problems[lang].map((p) => (
          <li class="flex items-start gap-3 rounded-xl bg-slate-50 p-4"><Icon name="tools" class="size-5 shrink-0 text-brand-600" />{p}</li>
        ))}
      </ul>

      <h2 class="h2 mt-12">{u.includesTitle}</h2>
      <ul class="mt-6 space-y-3">
        {s.includes[lang].map((p) => (
          <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 size-6 shrink-0 text-wa" />{p}</li>
        ))}
      </ul>

      <h2 class="h2 mt-12">{u.serviceAreasTitle}</h2>
      {countryOrder.map((cc) => (
        <>
          <h3 class="mt-6 text-sm font-semibold text-muted uppercase">{countries[cc].name[lang]}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {topLevel(cc).map((c) => (
              <li><a href={href(lang, `/areas/${c.slug}/`)} class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-slate-200 px-4 hover:border-brand-500 hover:text-brand-600"><Icon name="pin" class="size-4" />{c.name[lang]}</a></li>
            ))}
          </ul>
        </>
      ))}
    </article>

    <aside class="lg:sticky lg:top-24 lg:self-start" id="book">
      <h2 class="mb-4 text-xl font-bold">{u.bookTitle}</h2>
      <BookingForm lang={lang} service={s.slug} />
    </aside>
  </div>

  <Faq title={u.faqTitle} items={faqs} />

  <section class="bg-slate-50">
    <div class="container-x py-14">
      <h2 class="h2">{u.otherServices}</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((o) => (
          <a href={href(lang, `/services/${o.slug}/`)} class="flex min-h-14 items-center gap-3 rounded-xl bg-white p-4 font-medium shadow-sm ring-1 ring-slate-200 hover:ring-brand-500">
            <Icon name={o.icon} class="size-6 text-brand-600" />{o.name[lang]}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
